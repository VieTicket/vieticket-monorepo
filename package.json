{
  "name": "vieticket",
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.7.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1"
  },
  "packageManager": "bun@1.2.15",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@daveyplate/better-auth-ui": "3.0.0",
    "html-to-image": "^1.11.13",
    "mongoose": "^8.20.3",
    "resend": "^6.6.0"
  },
  "catalog": {
    "better-auth": "^1.4.3",
    "drizzle-orm": "^0.45.1",
    "typescript": "5.9.3"
  }
}